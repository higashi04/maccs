# Cadena de conexión a MongoDB Atlas
MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net/maccs?appName=maccs

# Secreto para firmar los JWT (usa un valor largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Duración de los JWT (formato de la librería `ms`: 1d, 12h, 30m, etc.)
JWT_EXPIRES=1d

# URL pública del frontend (para CORS y enlaces de restablecimiento de contraseña)
# En producción usa el dominio de Vercel, p. ej. https://maccs.vercel.app
CLIENT_URL=http://localhost:5173

# Puerto del servidor en desarrollo local (Vercel lo ignora)
PORT=5000
